    panel_data_root: "D:/cbond_on/panel_data",
    label_data_root: "D:/cbond_on/label_data",
  },
  factor_table: {
    table_id: "live",
    root: "D:/cbond_on/factor_store",
  },
  ads_root: "D:/cbond_on/ads",
  results_root: "D:/cbond_on/results",
  model_root: "D:/cbond_on/results/models",
  score_root: "D:/cbond_on/results/scores",
  logs_root: "D:/cbond_on/logs"
}
