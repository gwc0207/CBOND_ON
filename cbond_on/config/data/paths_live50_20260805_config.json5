{
  // Canonical live table profile. Production DataHub inputs and results/live
  // remain unchanged; factor values are managed only through the admitted
  // `live` canonical table below.
  raw_data_root: "D:/cbond_data_hub/raw_data",
  clean_data_root: "D:/cbond_data_hub/clean_data",
  cleaned_data_root: "D:/cbond_data_hub/clean_data",
  results_root: "D:/cbond_on/results",
  read_only_input_roots: {
    panel_data_root: "D:/cbond_on/panel_data",
    label_data_root: "D:/cbond_on/label_data",
  },
  factor_table: {
    table_id: "live",
    root: "D:/cbond_on/factor_store",
    writer: "admitted_live",
  },
}
