{
  // Research-only IC-alignment candidate.  It deliberately inherits the
  // current Regsim factor, rolling, regime, and execution-adjacent model
  // settings, while keeping every writable artifact under the experiment root.
  modules: ["models/lgbm/lgbm_screened_no_winsor_neutral_tminus1_regsim_w10_s15_d05_20260708"],

  model_name: "research_regsim_target_zscore_day_equal_day_mass_20260731",
  start: "2024-05-08",
  // Stop before the already viewed final-reporting segment begins.
  end: "2026-05-05",

  // The test cache builds scores without opening score-day labels.  Evaluation
  // must be a separate post-score command.
  score_only_no_target_label_read: true,
  // Preserve the fixed T-1 o_0005 score universe without opening that label.
  score_only_apply_tradable_filter: true,
  label_target_transform: {
    enabled: true,
    mode: "zscore_day",
    ddof: 0,
    min_std: 1e-12,
    // Equal aggregate MSE mass for each completed training day.  It keeps
    // intra-day relative weights but intentionally cancels day-level regime
    // and recency multipliers inherited from Regsim.
    loss_day_mass: "equal"
  },
  early_stopping_metric: "pearson_ic",

